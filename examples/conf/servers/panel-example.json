{
  "version": 1,
  "key": "remote",
  "label": "Example remote server",
  "flag": "",
  "display_order": 20,
  "connection": {
    "transport": "panel"
  },
  "monitoring": {
    "source": "remnawave",
    "node_uuid": "00000000-0000-0000-0000-000000000001"
  },
  "dns": {
    "expected_a_ip": "192.0.2.20"
  },
  "domains": [
    {
      "host": "remote-service.example.com",
      "checks": ["dns", "tls"],
      "tls_primary_port": 443,
      "tls_fallback_ports": []
    },
    {
      "host": "tls-fallback.example.com",
      "checks": ["dns", "tls"],
      "tls_primary_port": 443,
      "tls_fallback_ports": [8443]
    }
  ],
  "docker": {
    "containers": []
  },
  "fail2ban": {
    "enabled": false,
    "log_path": "/var/log/fail2ban.log",
    "timezone": "UTC"
  }
}
